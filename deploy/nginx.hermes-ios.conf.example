server {
    listen 8650 ssl;
    listen [::]:8650 ssl;
    server_name hermes.example.com;

    ssl_certificate /etc/ssl/hermes.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/hermes.example.com/privkey.pem;

    # Public clients must use Hermes OAuth. Do not expose the legacy password
    # provider even if the shared Hermes profile still has it configured.
    location = /auth/password-login {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:9120;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
